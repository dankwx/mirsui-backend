SUPABASE_URL=
SUPABASE_KEY=
# Service role key (Supabase > Project Settings > API). Usada SÓ pelo job diário
# dos Stakes, que precisa ler/escrever dados de todos os usuários (ignora RLS).
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
PORT=3000

# Faixas pedidas por chart de gênero. O teto do endpoint é 300 (medido), e é
# esse o padrão no código — aqui está freado em 100 de propósito.
#
# Soltar para 300 triplica a cobertura pelas mesmas 28 requisições, mas insere
# ~4.305 faixas novas de uma vez: o catálogo pula de 6.490 para ~10.795, o que
# passa do OBS_MAX_CATALOGO e desliga a descoberta do ADR 001 sozinha.
#
# A condição que faltava (itens 2 e 3 da análise: índices enxutos e gravação por
# delta) já foi cumprida em 15/08/2026, então soltar é decisão de quando, não de
# se. Ver docs/analise-escala-apis-e-banco.md, seção 4.1.
OBS_LIMITE_CHART=100
