SUPABASE_URL=
SUPABASE_KEY=
# Service role key (Supabase > Project Settings > API). Usada SÓ pelo job diário
# dos Stakes, que precisa ler/escrever dados de todos os usuários (ignora RLS).
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=

# OPCIONAIS a partir de 15/08/2026. O serviço sobe e funciona inteiro sem elas.
#
# A fonte de metadado e de métrica é o Deezer, que não pede chave nenhuma. O que
# o Spotify ainda faz é dizer qual é o id DELE para uma gravação que já
# identificamos por ISRC, para o botão "ouvir no Spotify" cair na faixa exata em
# vez de cair numa busca — enriquecimento, não requisito.
#
# Sem estas duas: o botão continua existindo e abre a busca do Spotify já
# preenchida (open.spotify.com/search/<artista título>). É a única diferença
# visível, e é o teste de aceitação de docs/plano-independencia-do-spotify.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPCIONAL. A prévia de 30 s agora vem do Deezer, no mesmo objeto da faixa e sem
# cota. O YouTube ficou como segunda opção, para faixa sem prévia — o que
# derrubou o consumo da cota (10.000 unidades/dia ÷ 100 por busca = 100 buscas
# por dia para o produto inteiro) para perto de zero.
YOUTUBE_API_KEY=

PORT=3000

# Faixas pedidas por chart de gênero. O teto do endpoint é 300 (medido), e é
# esse o padrão no código — aqui está freado em 100 de propósito.
#
# Soltar para 300 triplica a cobertura pelas mesmas 28 requisições, mas insere
# ~4.305 faixas novas de uma vez: o catálogo pula de 6.490 para ~10.795, o que
# passa do OBS_MAX_CATALOGO e desliga a descoberta do ADR 001 sozinha.
#
# A condição que faltava (itens 2 e 3 da análise: índices enxutos e gravação por
# delta) já foi cumprida em 15/08/2026, então soltar é decisão de quando, não de
# se. Ver docs/analise-escala-apis-e-banco.md, seção 4.1.
OBS_LIMITE_CHART=100

# OBS_LIMITE_SPOTIFY saiu: a etapa que ela freava não existe mais. A resolução
# ISRC -> id do Spotify deixou de ser varredura noturna (2.027 buscas por noite,
# a parte da rodada que mais falhava) e virou preguiçosa — quem abre a página de
# uma faixa resolve aquela faixa, uma vez, para sempre. Ver a fase 4 de
# docs/plano-independencia-do-spotify.md.
#
# As outras continuam valendo, todas com padrão "sem teto":
#   OBS_MAX_GENEROS  OBS_LIMITE_ACERVO  OBS_LIMITE_MEDICAO  OBS_LIMITE_ISRC
