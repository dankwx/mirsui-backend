SUPABASE_URL=
SUPABASE_KEY=
# Service role key (Supabase > Project Settings > API). Usada SÓ pelo job diário
# dos Stakes, que precisa ler/escrever dados de todos os usuários (ignora RLS).
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=

# OPCIONAIS a partir de 15/08/2026. O serviço sobe e funciona inteiro sem elas.
#
# A fonte de metadado e de métrica é o Deezer, que não pede chave nenhuma. O que
# o Spotify ainda faz é dizer qual é o id DELE para uma gravação que já
# identificamos por ISRC, para o botão "ouvir no Spotify" cair na faixa exata em
# vez de cair numa busca — enriquecimento, não requisito.
#
# Sem estas duas: o botão continua existindo e abre a busca do Spotify já
# preenchida (open.spotify.com/search/<artista título>). É a única diferença
# visível, e é o teste de aceitação de docs/plano-independencia-do-spotify.md.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# OPCIONAL. A prévia de 30 s agora vem do Deezer, no mesmo objeto da faixa e sem
# cota. O YouTube ficou como segunda opção, para faixa sem prévia — o que
# derrubou o consumo da cota (10.000 unidades/dia ÷ 100 por busca = 100 buscas
# por dia para o produto inteiro) para perto de zero.
YOUTUBE_API_KEY=

PORT=3000

# Faixas pedidas por chart de gênero. O teto do endpoint é 300 (medido), e é
# esse o padrão no código — aqui está freado em 100 de propósito.
#
# Soltar para 300 triplica a cobertura pelas mesmas 28 requisições, mas insere
# ~4.305 faixas novas de uma vez: o catálogo pula de 6.490 para ~10.795, o que
# passa do OBS_MAX_CATALOGO e desliga a descoberta do ADR 001 sozinha.
#
# A condição que faltava (itens 2 e 3 da análise: índices enxutos e gravação por
# delta) já foi cumprida em 15/08/2026, então soltar é decisão de quando, não de
# se. Ver docs/analise-escala-apis-e-banco.md, seção 4.1.
OBS_LIMITE_CHART=100

# OBS_LIMITE_SPOTIFY saiu: a etapa que ela freava não existe mais. A resolução
# ISRC -> id do Spotify deixou de ser varredura noturna (2.027 buscas por noite,
# a parte da rodada que mais falhava) e virou preguiçosa — quem abre a página de
# uma faixa resolve aquela faixa, uma vez, para sempre. Ver a fase 4 de
# docs/plano-independencia-do-spotify.md.
#
# As outras continuam valendo, todas com padrão "sem teto":
#   OBS_MAX_GENEROS  OBS_LIMITE_ACERVO  OBS_LIMITE_MEDICAO  OBS_LIMITE_ISRC

# ---------------------------------------------------------------------------
# Cadência adaptativa (item 4 da análise de escala, migration 025)
# ---------------------------------------------------------------------------
# A etapa 3 mede quem VENCEU a própria banda, gastando um orçamento fixo por
# noite. É a diferença entre uma rodada que cresce com o catálogo e uma que não.
#
#   quente  stake ativo, salva, entrou há < OBS_JANELA_NOVIDADE, ou subindo
#   morna   teve movimento nos últimos OBS_JANELA_MOVIMENTO dias
#   fria    nada disso
#
# Popularidade NÃO entra em critério nenhum. O eixo é interesse e movimento:
# faixa no rank 400.000 que alguém salvou é quente; faixa no rank 800 que
# ninguém tocou e não mexe há dois meses é fria.
#
# A conta, e é a banda fria que manda (é o grosso da massa num catálogo maduro):
#
#   custo/dia = 0,05N + 0,25N/7 + 0,70N/C_fria
#
#   C_fria = 30  ->  0,109N  ->  9,2x mais catálogo pelo mesmo orçamento
#   C_fria = 14  ->  0,136N  ->  7,4x   <- padrão
#   C_fria =  7  ->  0,186N  ->  5,4x
#
# 30 rende mais e é o número da seção 5.1 do doc. O padrão é 14 porque a banda
# fria é onde mora a faixa obscura que ninguém tocou ainda e que está prestes a
# estourar — a tese do produto. Ela vira quente na primeira medição que detectar
# a subida, então a subida não se perde; perde-se o COMEÇO dela, e a janela cega
# tem exatamente o tamanho desta cadência.
#
# ATENÇÃO: enquanto o catálogo inteiro for mais novo que OBS_JANELA_NOVIDADE,
# tudo é quente e a cadência não economiza nada. Não é configuração que não
# pegou — é o critério "entrou há pouco" funcionando. O campo `bandas` do log
# mostra a distribuição real de cada noite.
#
# OBS_ORCAMENTO_MEDICAO é o teto de requisições da etapa 3. A ~8 req/s, 12.000
# são ~25 min. Diferente dos OBS_LIMITE_*, este corte não é silencioso: o log
# traz `filaVencida` e `adiadas` toda noite.
#
# OBS_ORCAMENTO_MEDICAO=12000
# OBS_CADENCIA_MORNA=7
# OBS_CADENCIA_FRIA=14
# OBS_JANELA_MOVIMENTO=30
# OBS_JANELA_NOVIDADE=30

# ---------------------------------------------------------------------------
# Descoberta: duas fontes, um orçamento (ADR 001 + ADR 002, migration 026)
# ---------------------------------------------------------------------------
# O orçamento da noite (OBS_LIMITE_DESCOBERTA, em faixas NOVAS) é dividido entre
# dois mecanismos. Medido em 16/08/2026, mesmas cinco sementes nos dois:
#
#   mecanismo          faixas/req   ISRC      rank mediana   rank p90
#   ------------------ ------------ --------- -------------- ----------
#   radio (ADR 001)    3,00         0/15      447.301        607.033
#   related -> album   4,65         93/93     38.978         144.526
#
# Para comparar: o chart tem rank mediano 865.789 e o piso dele é 721.380. Ou
# seja, o p90 do rádio (607.033) encosta no chart — um décimo do que a descoberta
# traz hoje já é praticamente mainstream.
#
# E o rádio NÃO traz ISRC (o endpoint não devolve o campo). Como o ISRC é o
# endereço da página desde a 023, toda faixa vinda do rádio nasce sem página e
# cai na fila da etapa 4: o custo real por faixa útil é ~2 requisições, não 1.
# A caminhada por álbum traz 100% com ISRC — nasce com página, etapa 4 não paga.
#
# OBS_DESCOBERTA_SPLIT_ALBUM é a fração para a caminhada. 0 = só rádio (volta ao
# comportamento do ADR 001), 1 = só caminhada. O padrão 0,7 NÃO é meio-termo: as
# duas convivem porque ninguém sabe de que faixa de rank sai a faixa que estoura.
# Se o salto típico for 400k -> 900k o rádio está mirando certo; se for
# 39k -> 400k, a caminhada está. `origin_list` guarda a procedência, e em ~60
# dias `select * from discovery_source_report()` decide isto com dado.
#
# OBS_DESCOBERTA_MAX_FAS é o dial de obscuridade: teto de fãs para um artista
# entrar na fronteira. Acima de 50.000 o artista já chega sozinho pelo chart ou
# porque alguém o salvou. Baixar afunda a caminhada; subir a aproxima do rádio.
#
# LIMITE DA FONTE, verificado: /artist/{id}/related de artista pequeno devolve
# ZERO artistas (artista 58732 -> 0). O grafo seca na ponta obscura, então a
# caminhada não afunda sozinha em profundidade — ela é re-semeada do catálogo
# quando a fronteira cai abaixo de OBS_DESCOBERTA_FRONTEIRA_MIN.
#
# OBS_DESCOBERTA_SPLIT_ALBUM=0.7
# OBS_DESCOBERTA_MAX_FAS=50000
# OBS_DESCOBERTA_RELACIONADOS=3
# OBS_DESCOBERTA_FRONTEIRA_MIN=50
# OBS_DESCOBERTA_ALBUNS_POR_ARTISTA=6
